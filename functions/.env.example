# Comma-separated verified accounts allowed to prepare firmware access.
INSTALLER_EMAILS=owner@example.com

# Strict defaults intended to limit accidental or abusive Storage usage.
LIMIT_PER_USER_HOUR=3
LIMIT_PER_USER_DAY=10
LIMIT_GLOBAL_DAY=30
SIGNED_URL_TTL_SECONDS=180

# Firmware preparations shared by all accounts on one public IP (IPv6 /64).
LIMIT_PER_IP_HOUR=3
LIMIT_PER_IP_DAY=10

# Combined API requests: preparation + installation reports, including calls
# rejected by account approval. These are NOT per-download or billing caps.
LIMIT_IP_REQUESTS_MINUTE=10
LIMIT_IP_REQUESTS_HOUR=60
LIMIT_IP_REQUESTS_DAY=100
LIMIT_ALL_REQUESTS_DAY=1000

# Direct Google function ingress. Do not change without verifying every route
# and spoofed-header behavior; an extra proxy can otherwise bypass IP limits.
IP_TRUSTED_PROXY_HOPS=1

# Set to true only after App Check is configured in config.js and Firebase.
ENFORCE_APP_CHECK=false
